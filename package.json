{
  "name": "world-clock",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
