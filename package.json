  "dependencies": {
    "@screenly-labs/signage-kit": "github:Screenly-Labs/signage-kit#2026.8.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.4.0",
    "browserslist": "^4.28.8",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2"
  }
}
